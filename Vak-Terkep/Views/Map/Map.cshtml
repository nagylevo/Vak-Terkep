@model Route
@{
    Layout = "~/Views/Shared/Layout2.cshtml";
}

<div id="form" style="max-width: fit-content">
    <table>
        <tr>
            <td>
                <canvas id="myCanvas" style="border:1px solid #000000; display: inline-block;"></canvas>
            </td>
        </tr>
        <tr>
            <td>
                <p style="text-align:center">
                    @{
                        var userName = Context.Session.GetString("userName");
                    }
                    @if (Model != null && !string.IsNullOrEmpty(Model.description))
                    {
                        <p style="font-size: 17pt; font-weight: bold">
                        @Model.description
                        </p>
                        @if (!string.IsNullOrEmpty(userName))
                        {
                            <form asp-controller="Save" asp-action="RouteSaving" method="post">
                                <input type="text" name="extraData" class="form-control" hidden value="@Model.textName" required />
                                <button type="submit" class="btn btn-primary mt-2">Mentés</button>
                            <button id="downloadBtn" class="btn btn-primary mt-2">Letöltés</button>
                            </form>
                        
                        }
                        else
                        {
                        <p style="font-style: italic; font-size: 15pt;">A mentés és letöltés funkciókhoz jelentkezz be!</p>
                        }
                    }
                    else
                    {
                        <span>Hiba</span>
                    }
                </p>
            </td>
        </tr>
    </table>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

