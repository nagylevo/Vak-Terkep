@{

    var imageUrl = Context.Session.GetString("profilePictureUrl") ?? "/userImage.png";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] Vak Térkép</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Vak_Terkep.styles.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet">

    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

    @RenderSection("Scripts", required: false)

</head>
<body>

    <header id="headerMenu">
        <div id="leftSection">
            @{
                var userName = Context.Session.GetString("userName");
            }
            @if (!string.IsNullOrEmpty(userName))
            {
                <img src="@imageUrl" id="pfpsmall" alt="Profile Picture" />
                @if (userName.Length > 8)
                {
                    userName = userName.Substring(0, 8) + "...";
                }
                <a id="linkButton" href="@Url.Action("User", "Map")">@userName</a>
            }
            else
            {
                <p>Vendég</p>
            }
        </div>

        <div id="centerSection">
            <a id="homeLink" href="@Url.Action("Start", "Map")">Vak-Térkép</a>
        </div>

        <div id="rightSection">
            @if (!string.IsNullOrEmpty(userName))
            {
                <a class="signButton" href="@Url.Action("LogOut", "Accounts")">Kijelentkezés</a>
            }
            else
            {
                <a class="signButton" href="@Url.Action("SignIn", "Map")">Bejelentkezés</a>
            }
        </div>
    </header>

    <div class="container">
        <main role="main">
            @RenderBody()
        </main>
    </div>
    




    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    
</body>
</html>